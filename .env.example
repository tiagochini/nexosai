# Copie somente os campos necessários para .env.local.
# Nunca preencha este arquivo com credenciais reais.

# Núcleo
DATABASE_URL=postgresql://USUARIO:SENHA_URL_ENCODED@127.0.0.1:5432/nexosAi
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_LOCAL_LONGA_E_ALEATORIA
JWT_SECRET=SUBSTITUA_POR_OUTRA_CHAVE_LOCAL_LONGA_E_ALEATORIA
# Generate 32 random bytes encoded as base64; keep this key outside the database.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# During rotation only: JSON array of previous base64 keys.
INTEGRATION_TOKEN_PREVIOUS_KEYS=[]

# Proteções recomendadas para banco restaurado
LOCAL_SAFE_MODE=true
DRY_RUN_MODE=true

# One-time safety switch for a verified legacy database that already has the
# core schema but does not yet have nexos_schema_migrations history.
MIGRATION_BASELINE_EXISTING_SCHEMA=false

# IA — opcionais; deixe vazio quando não for testar o provedor
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Meta
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_AUTO_SUBSCRIBE=false
# Domínio HTTPS ou túnel que recebe /api; localhost não é aceito pela Meta.
META_WEBHOOK_PUBLIC_BASE_URL=
# Academy owner routes stay disabled unless a private random 32-256 character
# secret is configured. Send it only in x-admin-secret over HTTPS, never a URL.
ACADEMY_ADMIN_SECRET=
