{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./token-crypto": "./src/integration-token-crypto.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "tokens:check": "tsx scripts/migrate-integration-tokens.ts",
    "tokens:migrate": "tsx scripts/migrate-integration-tokens.ts --execute",
    "test:token-encryption": "tsx scripts/test-integration-token-crypto.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:tracked": "node scripts/apply-migrations.mjs",
    "bootstrap:check": "node scripts/bootstrap-empty-database.mjs",
    "bootstrap:empty": "node scripts/bootstrap-empty-database.mjs --execute",
    "verify": "node scripts/verify-database.mjs",
    "test:checksum": "node --test scripts/sql-checksum.test.mjs",
    "test:migration-policy": "node --test scripts/migration-policy.test.mjs",
    "test:bootstrap-rollback": "node scripts/test-bootstrap-rollback.mjs",
    "seed:plans": "tsx src/seed-plans.ts",
    "seed:launches": "tsx src/seed-public-launches.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
