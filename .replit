modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NEXOS Full Audit Test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NEXOS Full Launch Simulation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NEXOS Full Platform Stress Test"

[[workflows.workflow]]
name = "NEXOS Full Audit Test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DRY_RUN_MODE=true pnpm --filter @workspace/scripts run nexos-audit-test"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "NEXOS Full Launch Simulation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run nexos-launch-sim"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "NEXOS Full Platform Stress Test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SAMPLE=3 pnpm --filter @workspace/scripts run stress-full"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 8000

[[ports]]
localPort = 18150
externalPort = 4200

[[ports]]
localPort = 23091
externalPort = 3001

[[ports]]
localPort = 23863
externalPort = 3002

[[ports]]
localPort = 25078
externalPort = 3003

[[ports]]
localPort = 25927
externalPort = 3000

[nix]
channel = "stable-25_05"

