{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "jornada-limpa-3": "tsx ./src/jornada-limpa-3.ts",
    "hello": "tsx ./src/hello.ts",
    "seed-plans": "tsx ./src/seed-plans.ts",
    "nexos-audit-test": "tsx ./src/nexos-audit-test.ts",
    "nexos-launch-sim": "tsx ./src/nexos-launch-sim.ts",
    "nexos-full-funnel": "tsx ./src/nexos-full-funnel-test.ts",
    "stress-test": "tsx ./src/stress-test/stress-test-runner.ts",
    "stress-test-dry": "cross-env DRY_RUN_MODE=true tsx ./src/stress-test/stress-test-runner.ts",
    "stress-test-extreme": "cross-env DRY_RUN_MODE=true EXTREME_ONLY=true tsx ./src/stress-test/stress-test-runner.ts",
    "stress-test-all": "cross-env DRY_RUN_MODE=true SAMPLE=50 OUTPUT=json tsx ./src/stress-test/stress-test-runner.ts",
    "stress-full": "tsx ./src/stress-test/nexos-stress-full.ts",
    "stress-full-3": "cross-env SAMPLE=3 tsx ./src/stress-test/nexos-stress-full.ts",
    "stress-full-10": "cross-env SAMPLE=10 tsx ./src/stress-test/nexos-stress-full.ts",
    "stress-full-critico": "cross-env DIFFICULTY=critico tsx ./src/stress-test/nexos-stress-full.ts",
    "proof-prohibited-promises": "tsx ./src/proof-prohibited-promises.ts",
    "proof-acknowledge": "tsx ./src/proof-acknowledge-and-wait.ts",
    "stress-full-extreme": "cross-env EXTREME_ONLY=true tsx ./src/stress-test/nexos-stress-full.ts",
    "stress-full-all": "cross-env ALL=true tsx ./src/stress-test/nexos-stress-full.ts",
    "generate-audit-pdf": "tsx ./src/generate-audit-pdf.ts",
    "generate-investor-prospect": "tsx ./src/generate-investor-prospect.ts",
    "generate-pdfs": "tsx ./src/generate-pdfs.ts",
    "b2-contract-violation-test": "tsx ./src/b2-contract-violation-test.ts",
    "c1-integration-validator-test": "tsx ./src/c1-integration-validator-test.ts",
    "e1-media-brief-gate-test": "tsx ./src/e1-media-brief-gate-test.ts",
    "diag-e2e": "tsx ./src/diag-e2e.ts",
    "diag-phase1": "tsx ./src/diag-phase1.ts",
    "diag-phase2": "tsx ./src/diag-phase2.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "pdfkit": "^0.18.0",
    "pdfmake": "^0.3.11",
    "playwright-core": "^1.61.0",
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
