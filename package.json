{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "homologation:prepare": "node scripts/homologation.mjs prepare",
    "homologation:verify": "node scripts/homologation.mjs verify",
    "homologation:seed": "node scripts/homologation.mjs seed",
    "homologation:founder": "node scripts/homologation.mjs founder",
    "homologation:redis": "node scripts/homologation.mjs redis",
    "homologation:smoke": "node scripts/homologation.mjs smoke",
    "dev:homologation": "node scripts/dev-local.mjs --homologation",
    "dev:local:meta-test": "node scripts/dev-local.mjs --meta-e2e",
    "dev:meta-gateway": "node scripts/meta-webhook-gateway.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:check-academy-client": "node --test scripts/check-academy-client-security.test.mjs",
    "security:check-runtime-logging": "node --test scripts/check-runtime-logging.test.mjs && node scripts/check-runtime-logging.mjs",
    "security:audit-dependencies": "pnpm audit --audit-level low",
    "security:audit-history": "node scripts/audit-sensitive-history.mjs",
    "test:p1-local": "node scripts/test-p1-local.mjs",
    "test:p2-local": "node scripts/test-p2-local.mjs",
    "test:docker-local": "node scripts/test-docker-deployment.mjs",
    "test:p3-local": "node scripts/test-p3-local.mjs",
    "test:ai-quality": "node --test scripts/evaluate-ai-quality.test.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
