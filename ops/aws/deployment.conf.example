# Deployment/runtime configuration. Copy to /etc/nexos/deployment.conf.
# Keep database/app settings in app.env. Store all external provider settings
# together in the JSON secret referenced below; see external-apis.secret.example.json.
APP_ENV_SOURCE_FILE=/etc/nexos/app.env
APP_ENV_FILE=/etc/nexos/app.env.resolved
REDIS_PASSWORD_FILE=/etc/nexos/redis-password
DATABASE_CA_FILE=/etc/nexos/rds-ca.pem
AWS_DEFAULT_REGION=us-east-2
# Single source of truth for third-party API credentials, IDs, URLs and options.
NEXOS_EXTERNAL_APIS_SECRET_ARN=
WEB_PORT=8081
NEXOS_DATABASE_NETWORK=nexos-production-database
# Change both tags for each release. Keep previous images for rollback.
NEXOS_API_IMAGE=nexos-api:release-001
NEXOS_WEB_IMAGE=nexos-web:release-001
