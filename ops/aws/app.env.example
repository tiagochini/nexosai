# init creates independent signing secrets and an encryption key for a NEW environment.
# Restored encrypted integration tokens require the ORIGINAL encryption key.
DATABASE_URL=postgresql://USUARIO:SENHA_URL_ENCODED@ENDPOINT_RDS:5432/nexos
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/run/secrets/database_ca
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
APP_URL=https://agencianexos.vip
ALLOWED_ORIGINS=https://agencianexos.vip
NEXOS_BASE_DOMAIN=agencianexos.vip
QUEUE_PREFIX=production
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Put all third-party integration settings (credentials, IDs, URLs and options)
# in the single JSON secret documented in external-apis.secret.example.json.
# This file is reserved for NexOS runtime/database configuration.
# These flags cover specific paths; production schedulers still start.
DRY_RUN_MODE=true
DISABLE_SCHEDULED_VIDEO_GENERATION=true
PLATFORM_ADMIN_USER_IDS=
ACADEMY_ADMIN_USER_IDS=
# Add only credentials for enabled providers. Never put them in deployment.conf.
