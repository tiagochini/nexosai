# init creates independent signing secrets and an encryption key for a NEW environment.
# Restored encrypted integration tokens require the ORIGINAL encryption key.
DATABASE_URL=postgresql://USUARIO:SENHA_URL_ENCODED@ENDPOINT_RDS:5432/nexos
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/run/secrets/database_ca
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
APP_URL=https://agencianexos.vip
ALLOWED_ORIGINS=https://agencianexos.vip
NEXOS_BASE_DOMAIN=agencianexos.vip
QUEUE_PREFIX=production
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# External provider setup. Put credentials here OR use the matching *_ARN below.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
NEXOS_OPENAI=
GEMINI_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=lancamento@agencianexos.vip
SMTP_HOST=
