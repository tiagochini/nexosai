FROM node:24-bookworm-slim AS build
WORKDIR /workspace
RUN npm install -g pnpm@11.19.0
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/app... --filter @workspace/nexos-academy...
RUN pnpm --filter @workspace/app run build
RUN BASE_PATH=/nexos-academy/ pnpm --filter @workspace/nexos-academy run build

FROM nginx:1.28-alpine
COPY ops/app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/artifacts/app/dist/public /usr/share/nginx/html
COPY --from=build /workspace/artifacts/nexos-academy/dist/public /usr/share/nginx/html/nexos-academy
EXPOSE 8080
