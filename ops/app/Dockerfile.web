FROM node:24-bookworm-slim AS build
WORKDIR /workspace
RUN npm install -g pnpm@11.19.0
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/app...
RUN pnpm --filter @workspace/app run build

FROM nginx:1.28-alpine
COPY ops/app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/artifacts/app/dist/public /usr/share/nginx/html
EXPOSE 8080
